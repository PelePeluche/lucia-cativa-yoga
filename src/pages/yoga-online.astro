---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionTitle from '../components/ui/common/SectionTitle.astro';
---

<Layout title="Yoga Online - Lu Cativa">
  <Header />
  
  <!-- Hero section -->
  <section class="pt-24 pb-16 bg-lucia-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-heading text-lucia-brown mb-6">
        Yoga Online
      </h1>
      <p class="text-xl text-lucia-mauve mb-8">
        Clases de Vinyasa Yoga desde la comodidad de tu hogar
      </p>
      <p class="text-lg text-lucia-brown leading-relaxed">
        Próximamente encontrarás aquí todas las clases online, programas de práctica 
        y contenido exclusivo para tu desarrollo en el yoga.
      </p>
    </div>
  </section>

  <!-- Contenido temporal -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <SectionTitle 
        title="Contenido en desarrollo" 
        alignment="center" 
        titleColor="text-lucia-brown" 
        lineColor="bg-lucia-mauve"
      />
      
      <div class="text-center">
        <p class="text-lucia-brown mb-8 leading-relaxed">
          Estamos preparando una experiencia única para tu práctica online. 
          Mientras tanto, puedes seguirme en Instagram para contenido diario.
        </p>
        
        <a 
          href="https://www.instagram.com/lucativa.yoga?igsh=MXRkYWt0dWFnNHZ2bA=="
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-4 bg-lucia-mauve text-white font-medium text-center tracking-wide uppercase hover:bg-lucia-rose hover:text-lucia-brown transition duration-300 rounded-sm"
        >
          Seguir en Instagram
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
