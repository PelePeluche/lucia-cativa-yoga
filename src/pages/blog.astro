---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionTitle from '../components/ui/common/SectionTitle.astro';
import { SECTION_SPACING, AOS_PRESETS, RESPONSIVE_CLASSES } from '../constants';
---

<Layout title="Blog - Lu Cativa">
  <Header />
  
  <!-- Hero section -->
  <section class="pt-24 pb-16 bg-lucia-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class={`${RESPONSIVE_CLASSES.text.heading} font-heading text-lucia-brown mb-6`}>
        Blog
      </h1>
    </div>
  </section>

  <!-- Contenido principal -->
  <section class={`${SECTION_SPACING.padding.mobile} ${SECTION_SPACING.padding.desktop} bg-white`}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <div class="text-center" {...AOS_PRESETS.fadeUp}>
        <p class={`${RESPONSIVE_CLASSES.text.body} text-lucia-brown leading-relaxed`}>
          Un espacio para compartir reflexiones, experiencias y prácticas de yoga, contadas desde mi recorrido.
        </p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
