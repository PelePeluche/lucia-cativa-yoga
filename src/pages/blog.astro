---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionTitle from '../components/ui/common/SectionTitle.astro';
---

<Layout title="Blog - Lu Cativa">
  <Header />
  
  <!-- Hero section -->
  <section class="pt-24 pb-16 bg-lucia-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-heading text-lucia-brown mb-6">
        Blog
      </h1>
      <p class="text-xl text-lucia-mauve mb-8">
        Reflexiones sobre yoga, movimiento y transformación
      </p>
      <p class="text-lg text-lucia-brown leading-relaxed">
        Un espacio para compartir experiencias, conocimientos y reflexiones 
        sobre la práctica del yoga y el camino de autoconocimiento.
      </p>
    </div>
  </section>

  <!-- Contenido temporal -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <SectionTitle 
        title="Próximamente" 
        alignment="center" 
        titleColor="text-lucia-brown" 
        lineColor="bg-lucia-mauve"
      />
      
      <div class="text-center">
        <p class="text-lucia-brown mb-8 leading-relaxed">
          Estoy preparando contenido valioso para compartir contigo. 
          Aquí encontrarás artículos sobre técnicas de yoga, filosofía, 
          experiencias personales y consejos para profundizar tu práctica.
        </p>
        
        <p class="text-lucia-mauve mb-8 font-medium">
          Mientras tanto, puedes seguir mi contenido diario en Instagram.
        </p>
        
        <a 
          href="https://www.instagram.com/lucativa.yoga?igsh=MXRkYWt0dWFnNHZ2bA=="
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-4 bg-lucia-mauve text-white font-medium text-center tracking-wide uppercase hover:bg-lucia-rose hover:text-lucia-brown transition duration-300 rounded-sm"
        >
          Seguir en Instagram
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
