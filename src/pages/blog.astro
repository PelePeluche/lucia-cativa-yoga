---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SectionTitle from '../components/ui/common/SectionTitle.astro';
import { SECTION_SPACING, AOS_PRESETS, RESPONSIVE_CLASSES } from '../constants';
---

<Layout title="Blog - Lu Cativa">
  <Header />
  
  <!-- Blog section with teal background -->
  <section class="pt-24 pb-20" style="background-color: #577874; min-height: 80vh;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <!-- Header -->
      <div class="text-center mb-16" {...AOS_PRESETS.fadeUp}>
        <h1 class={`${RESPONSIVE_CLASSES.text.heading} font-heading text-white mb-6`}>
          Blog
        </h1>
        <div class="w-16 h-1 bg-lucia-rose mx-auto mb-8 rounded-full"></div>
        <p class={`${RESPONSIVE_CLASSES.text.large} text-lucia-cream leading-relaxed max-w-3xl mx-auto`}>
          Un espacio para compartir reflexiones, experiencias y prácticas de yoga, contadas desde mi recorrido.
        </p>
      </div>

      <!-- Coming Soon Content -->
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12" {...AOS_PRESETS.fadeUp}>
          <div class="bg-white bg-opacity-10 backdrop-blur-sm rounded-lg p-8 mb-8">
            <div class="mb-6">
              <svg class="w-16 h-16 mx-auto text-lucia-rose mb-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
              </svg>
              <h2 class={`${RESPONSIVE_CLASSES.text.subheading} font-heading text-white mb-4`}>
                Próximamente
              </h2>
              <p class={`${RESPONSIVE_CLASSES.text.body} text-lucia-cream leading-relaxed mb-6`}>
                Estoy preparando contenido especial para compartir contigo. Aquí encontrarás reflexiones sobre la práctica, consejos para profundizar tu yoga y experiencias desde mi camino como instructora.
              </p>
            </div>
          </div>
        </div>

        <!-- Future blog topics preview -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6" {...AOS_PRESETS.fadeUp}>
          <div class="bg-white bg-opacity-10 backdrop-blur-sm rounded-lg p-6 text-center">
            <div class="w-12 h-12 bg-lucia-rose rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <h3 class={`${RESPONSIVE_CLASSES.text.body} font-medium text-white mb-2`}>Práctica Personal</h3>
            <p class="text-sm text-lucia-cream opacity-90">Reflexiones sobre el yoga en la vida cotidiana</p>
          </div>
          
          <div class="bg-white bg-opacity-10 backdrop-blur-sm rounded-lg p-6 text-center">
            <div class="w-12 h-12 bg-lucia-rose rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M9.5 16a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13z"/>
                <path d="M18.5 16a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13z"/>
              </svg>
            </div>
            <h3 class={`${RESPONSIVE_CLASSES.text.body} font-medium text-white mb-2`}>Técnicas</h3>
            <p class="text-sm text-lucia-cream opacity-90">Consejos y guías para mejorar tu práctica</p>
          </div>
          
          <div class="bg-white bg-opacity-10 backdrop-blur-sm rounded-lg p-6 text-center">
            <div class="w-12 h-12 bg-lucia-rose rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </div>
            <h3 class={`${RESPONSIVE_CLASSES.text.body} font-medium text-white mb-2`}>Experiencias</h3>
            <p class="text-sm text-lucia-cream opacity-90">Historias y aprendizajes del camino</p>
          </div>
        </div>

        <!-- Newsletter signup suggestion -->
        <div class="text-center mt-12" {...AOS_PRESETS.fadeUp}>
          <p class={`${RESPONSIVE_CLASSES.text.body} text-lucia-cream mb-4`}>
            ¿Querés ser la primera en saber cuando publique nuevos artículos?
          </p>
          <a 
            href="/yoga-online" 
            class="inline-block px-8 py-3 bg-lucia-rose text-white font-medium text-sm tracking-wide uppercase hover:bg-lucia-mauve transition-all duration-300 rounded-sm"
          >
            Mantente conectada
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
