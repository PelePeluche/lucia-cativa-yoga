---
import '../styles/global.css';
import '../styles/custom.css';
// Importar AOS CSS - Para las animaciones al hacer scroll
// import 'aos/dist/aos.css';
import { getLanguageFromURL, useTranslations, DEFAULT_LANGUAGE } from '../i18n/utils';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SOCIAL_LINKS } from '../constants/site';
// Eliminamos la importación de fuentes, usaremos Google Fonts directamente

interface Props {
  title?: string;
  description?: string;
  // Imagen para compartir en redes (ruta dentro de public/)
  image?: string;
  // true en páginas que no deben aparecer en Google (404, design system)
  noindex?: boolean;
}

// Get the current language from the URL or use default
const pathname = new URL(Astro.request.url).pathname;
const currentLang = getLanguageFromURL(pathname) || DEFAULT_LANGUAGE;
const t = useTranslations(currentLang);

const {
  title = t('meta.title'),
  description = t('meta.description'),
  image = '/img/hero-yoga.jpeg',
  noindex = false,
} = Astro.props;

const SITE_URL = 'https://luciacativayoga.com';
// Redes y buscadores ignoran las URLs relativas en og:image: tiene que ser absoluta
const imageUrl = new URL(image, SITE_URL).href;

// Solo el home tiene versión en inglés. hreflang le dice a Google cuál mostrar
// según el idioma de quien busca; en el resto de las páginas no aplica.
const isHome = pathname === '/' || pathname === '/en/' || pathname === '/en';
const alternates = isHome
  ? [
      { lang: 'es', href: `${SITE_URL}/` },
      { lang: 'en', href: `${SITE_URL}/en/` },
      { lang: 'x-default', href: `${SITE_URL}/` },
    ]
  : [];

// Instagram sin el parámetro de tracking (?igsh=...) para que Google
// reconozca el perfil como la misma entidad.
const instagramUrl = SOCIAL_LINKS.instagram.split('?')[0];

// Structured data (JSON-LD) for Local Business — content comes from i18n
const structuredData = {
  '@context': 'https://schema.org',
  // SportsActivityLocation es un subtipo de LocalBusiness, más preciso para un estudio de yoga
  '@type': 'SportsActivityLocation',
  '@id': `${SITE_URL}/#business`,
  name: 'Lucía Cativa - Vinyasa Yoga',
  description: t('meta.structuredData.description'),
  url: SITE_URL,
  image: `${SITE_URL}/img/hero-yoga.jpeg`,
  logo: `${SITE_URL}/img/IDENTIDAD%20YOGA%20(500%20x%20150%20px).svg`,
  telephone: '+54-9-351-622-5399',
  email: 'lucativayoga@gmail.com',
  founder: {
    '@type': 'Person',
    name: 'Lucía Cativa',
    jobTitle: t('meta.structuredData.jobTitle'),
    description: t('meta.structuredData.founderDescription'),
  },
  serviceType: t('meta.structuredData.serviceType'),
  // Dirección de las clases presenciales (la misma que figura en /yoga-presencial)
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Fructuoso Rivera 1173',
    addressLocality: 'Córdoba',
    addressRegion: 'Córdoba',
    addressCountry: 'AR',
  },
  areaServed: [
    { '@type': 'City', name: 'Córdoba' },
    { '@type': 'Country', name: t('meta.structuredData.areaServed') },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t('meta.structuredData.offerCatalogName'),
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: t('meta.structuredData.offer1Name'),
          description: t('meta.structuredData.offer1Description'),
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: t('meta.structuredData.offer2Name'),
          description: t('meta.structuredData.offer2Description'),
        },
      },
    ],
  },
  sameAs: [instagramUrl, SOCIAL_LINKS.facebook],
};

const websiteData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Lucía Cativa Yoga',
  url: SITE_URL,
  inLanguage: currentLang,
  publisher: { '@id': `${SITE_URL}/#business` },
};
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload critical fonts -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Yeseva+One&display=swap" as="style" />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" as="style" />
    
    <!-- Load fonts with display=swap for better performance -->
    <link href="https://fonts.googleapis.com/css2?family=Yeseva+One&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- DM Sans (closest to Canva Sans): used by the flyer panels on Yoga Presencial -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400;1,500;1,700&display=swap" rel="stylesheet" />
    
    <!-- Preload critical images -->
    <link rel="preload" href="/img/hero-yoga.jpeg" as="image" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- SEO Keywords -->
    <meta name="keywords" content={t('meta.keywords')} />

    <!-- Open Graph / Facebook / WhatsApp: usa la descripción de cada página -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lucía Cativa Yoga" />
    <meta property="og:locale" content={currentLang === 'en' ? 'en_US' : 'es_AR'} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <!-- Additional SEO Meta Tags -->
    <meta name="author" content="Lucía Cativa" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="language" content={currentLang} />
    {!noindex && <link rel="canonical" href={Astro.url} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteData)} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Performance optimizations -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    <link rel="dns-prefetch" href="//unpkg.com">
    
    <!-- Accessibility improvements -->
    <meta name="theme-color" content="#a3738b">
    <meta name="msapplication-TileColor" content="#a3738b">
    
    <!-- Additional meta for better indexing -->
    <meta name="geo.region" content="AR-X">
    <meta name="geo.placename" content="Córdoba, Argentina">
    <meta name="format-detection" content="telephone=no">
  </head>
  <body class="font-body bg-white text-lucia-ink min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scripts de AOS para animaciones al hacer scroll (usando CDN) -->
    <!-- <script src="https://unpkg.com/aos@next/dist/aos.js" is:inline></script> -->
    <script src="/src/scripts/main.ts"></script>
  </body>
</html>
