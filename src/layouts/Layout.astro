---
import '../styles/global.css';
import '../styles/custom.css';
// Importar AOS CSS - Para las animaciones al hacer scroll
// import 'aos/dist/aos.css';
import { getLanguageFromURL, useTranslations, DEFAULT_LANGUAGE } from '../i18n/utils';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
// Eliminamos la importación de fuentes, usaremos Google Fonts directamente

interface Props {
  title?: string;
  description?: string;
}

// Get the current language from the URL or use default
const pathname = new URL(Astro.request.url).pathname;
const currentLang = getLanguageFromURL(pathname) || DEFAULT_LANGUAGE;
const t = useTranslations(currentLang);

const { title = t('meta.title'), description = t('meta.description') } = Astro.props;

// Structured data (JSON-LD) for Local Business — content comes from i18n
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://luciacativayoga.com',
  name: 'Lucía Cativa - Vinyasa Yoga',
  description: t('meta.structuredData.description'),
  url: 'https://luciacativayoga.com',
  telephone: '+54-9-351-622-5399',
  email: 'lucativayoga@gmail.com',
  founder: {
    '@type': 'Person',
    name: 'Lucía Cativa',
    jobTitle: t('meta.structuredData.jobTitle'),
    description: t('meta.structuredData.founderDescription'),
  },
  serviceType: t('meta.structuredData.serviceType'),
  areaServed: {
    '@type': 'Country',
    name: t('meta.structuredData.areaServed'),
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t('meta.structuredData.offerCatalogName'),
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: t('meta.structuredData.offer1Name'),
          description: t('meta.structuredData.offer1Description'),
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: t('meta.structuredData.offer2Name'),
          description: t('meta.structuredData.offer2Description'),
        },
      },
    ],
  },
  sameAs: ['https://instagram.com/luciacativa', 'https://facebook.com/luciacativa'],
};
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload critical fonts -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Yeseva+One&display=swap" as="style" />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" as="style" />
    
    <!-- Load fonts with display=swap for better performance -->
    <link href="https://fonts.googleapis.com/css2?family=Yeseva+One&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- DM Sans (closest to Canva Sans): used by the flyer panels on Yoga Presencial -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400;1,500;1,700&display=swap" rel="stylesheet" />
    
    <!-- Preload critical images -->
    <link rel="preload" href="/img/hero-yoga.jpeg" as="image" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- SEO Keywords -->
    <meta name="keywords" content={t('meta.keywords')} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t('meta.ogDescription')} />
    <meta property="og:image" content="/img/hero-yoga.jpeg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={t('meta.ogDescription')} />
    <meta property="twitter:image" content="/img/hero-yoga.jpeg" />
    <!-- Additional SEO Meta Tags -->
    <meta name="author" content="Lucía Cativa" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content={currentLang} />
    <link rel="canonical" href={Astro.url} />
    
    <!-- Structured Data for Local Business -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Yeseva+One&display=swap" rel="stylesheet" />
    
    <!-- Performance optimizations -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    <link rel="dns-prefetch" href="//unpkg.com">
    
    <!-- Accessibility improvements -->
    <meta name="theme-color" content="#a3738b">
    <meta name="msapplication-TileColor" content="#a3738b">
    
    <!-- Additional meta for better indexing -->
    <meta name="geo.region" content="AR">
    <meta name="geo.placename" content="Argentina">
    <meta name="format-detection" content="telephone=no">
  </head>
  <body class="font-body bg-white text-lucia-brown min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scripts de AOS para animaciones al hacer scroll (usando CDN) -->
    <!-- <script src="https://unpkg.com/aos@next/dist/aos.js" is:inline></script> -->
    <script src="/src/scripts/main.ts"></script>
  </body>
</html>
