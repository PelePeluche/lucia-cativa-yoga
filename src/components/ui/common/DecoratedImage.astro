---
// Reusable Decorated Image Component with shadow effect
import type { DecoratedImageProps } from '../../../types/components';

interface Props extends DecoratedImageProps {}

const { src, alt, decorationColor = '#e0a6a8' } = Astro.props;
---

<figure class="relative">
  <div class="absolute inset-0 transform translate-x-3 translate-y-3 rounded-sm" style={`background-color: ${decorationColor};`}></div>
  <img 
    src={src} 
    alt={alt} 
    class="relative z-10 w-full h-auto rounded-sm shadow-md object-cover"
  />
</figure>
