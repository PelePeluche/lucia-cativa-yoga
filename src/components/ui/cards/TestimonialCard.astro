---
// Reusable Testimonial Card Component
import type { TestimonialCardProps } from '../../../types/components';

interface Props extends TestimonialCardProps {}

const { name, text } = Astro.props;
---

<div class="p-6 rounded-lg shadow-sm h-full flex flex-col" style="background-color: #577874;" data-aos="fade-up" data-aos-delay="300">
  <div class="mb-4">
    <h4 class="font-heading text-white text-lg">{name}</h4>
  </div>
  <p class="text-white leading-relaxed italic flex-grow">"{text}"</p>
</div>
