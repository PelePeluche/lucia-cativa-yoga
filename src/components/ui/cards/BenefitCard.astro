---
// Reusable Benefit Card Component
import type { BenefitCardProps } from '../../../types/components';

interface Props extends BenefitCardProps {}

const { icon, title, description } = Astro.props;
---

<div class="text-center p-6 bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay="200">
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="text-xl font-heading text-lucia-brown mb-3">{title}</h3>
  <p class="text-lucia-brown leading-relaxed">{description}</p>
</div>
