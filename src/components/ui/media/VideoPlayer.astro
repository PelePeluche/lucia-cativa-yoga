---
// VideoPlayer component - supports both local videos and YouTube embeds
export interface Props {
  src?: string;
  youtubeId?: string;
  title: string;
  poster?: string;
  autoplay?: boolean;
  controls?: boolean;
  muted?: boolean;
  loop?: boolean;
  width?: string;
  height?: string;
  className?: string;
}

const {
  src,
  youtubeId,
  title,
  poster,
  autoplay = false,
  controls = true,
  muted = true,
  loop = false,
  width = "100%",
  height = "auto",
  className = ""
} = Astro.props;

// Determine if it's a YouTube video or local video
const isYouTube = !!youtubeId;
const videoSrc = isYouTube ? `https://www.youtube.com/embed/${youtubeId}` : src;
---

<div class={`video-container ${className}`}>
  {isYouTube ? (
    <!-- YouTube Embed -->
    <div class="relative w-full" style="padding-bottom: 56.25%; /* 16:9 aspect ratio */">
      <iframe
        class="absolute top-0 left-0 w-full h-full rounded-lg shadow-lg"
        src={videoSrc}
        title={title}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  ) : (
    <!-- Local Video -->
    <video
      id={`video-${Math.random().toString(36).substr(2, 9)}`}
      class="w-full h-auto rounded-lg shadow-lg"
      src={videoSrc}
      title={title}
      poster={poster}
      controls={controls}
      autoplay={autoplay}
      {...(muted ? { muted: true } : {})}
      loop={loop}
      preload="metadata"
      style={`width: ${width}; height: ${height};`}
    >
      <p class="text-center text-gray-600 p-4">
        Tu navegador no soporta el elemento de video.
        <a href={videoSrc} class="text-lucia-teal hover:underline">Descargar video</a>
      </p>
    </video>
  )}
</div>

<style>
  .video-container {
    position: relative;
  }
  
  video {
    max-width: 100%;
    height: auto;
  }
  
  /* Responsive video styling */
  @media (max-width: 768px) {
    .video-container {
      margin: 0 -1rem;
    }
  }
</style>

{!isYouTube && autoplay && (
  <script define:vars={{ muted }}>
    document.addEventListener('DOMContentLoaded', function() {
      const videos = document.querySelectorAll('video[autoplay]');
      
      function tryPlayVideo(video) {
        console.log('Trying to play video with muted =', muted);
        
        // Set muted state from component prop
        video.muted = muted;
        console.log('Video muted property set to:', video.muted);
        
        const playPromise = video.play();
        
        if (playPromise !== undefined) {
          playPromise.then(() => {
            console.log('Video playing successfully with muted =', video.muted);
          }).catch((error) => {
            console.log('Autoplay failed:', error.message);
            // If autoplay fails and video was supposed to be unmuted, try muted autoplay
            if (!muted) {
              console.log('Autoplay with sound blocked, trying muted autoplay');
              video.muted = true;
              video.play().then(() => {
                console.log('Video now playing muted as fallback');
              }).catch((e) => {
                console.log('Autoplay completely blocked:', e);
              });
            }
          });
        }
      }
      
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const video = entry.target;
          if (entry.isIntersecting) {
            tryPlayVideo(video);
          } else {
            video.pause();
          }
        });
      }, {
        threshold: 0.5 // Play when 50% of video is visible
      });
      
      videos.forEach(video => {
        console.log('Video element found:', video);
        console.log('Video has muted attribute:', video.hasAttribute('muted'));
        console.log('Video muted property:', video.muted);
        console.log('Component muted prop:', muted);
        
        videoObserver.observe(video);
        
        // Check if video is already visible on page load
        const rect = video.getBoundingClientRect();
        const isVisible = rect.top < window.innerHeight && rect.bottom > 0;
        console.log('Video is visible on load:', isVisible);
        if (isVisible) {
          setTimeout(() => tryPlayVideo(video), 100); // Small delay to ensure everything is loaded
        }
      });
    });
  </script>
)}
