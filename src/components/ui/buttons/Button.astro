---
// Basic Button Component
import type { ButtonProps } from '../../../types/components';

interface Props extends ButtonProps {}

const { 
  type = 'button',
  variant = 'primary', 
  size = 'medium',
  disabled = false
} = Astro.props;

const variantClasses = {
  primary: 'bg-lucia-mauve text-white hover:bg-lucia-rose hover:text-lucia-brown',
  secondary: 'bg-lucia-teal text-white hover:bg-lucia-mauve',
  outline: 'bg-transparent border-2 border-lucia-mauve text-lucia-mauve hover:bg-lucia-mauve hover:text-white'
};

const sizeClasses = {
  small: 'px-4 py-2 text-sm',
  medium: 'px-6 py-3 text-base',
  large: 'px-8 py-4 text-lg'
};
---

<button 
  type={type}
  disabled={disabled}
  class={`font-medium text-center tracking-wide uppercase transition duration-300 rounded-sm ${variantClasses[variant]} ${sizeClasses[size]} ${disabled ? 'opacity-50 cursor-not-allowed' : ''}`}
>
  <slot />
</button>
