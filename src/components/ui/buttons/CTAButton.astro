---
// Reusable CTA Button Component
import type { CTAButtonProps } from '../../../types/components';

interface Props extends CTAButtonProps {}

const { 
  href, 
  variant = 'primary', 
  size = 'medium',
  target = '_self',
  class: className = ''
} = Astro.props;

const variantClasses = {
  primary: 'text-white transition-all duration-300',
  secondary: 'bg-white text-lucia-ink transition-all duration-300',
  outline: 'bg-transparent border-2 border-lucia-cream text-lucia-cream hover:bg-lucia-cream hover:text-lucia-ink'
};

const sizeClasses = {
  small: 'px-4 py-2 text-sm',
  medium: 'px-10 py-4 text-sm',
  large: 'px-12 py-4 text-sm'
};
---

<a 
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  class={`inline-block font-medium text-center tracking-widest uppercase rounded-sm ${variantClasses[variant]} ${sizeClasses[size]} ${className}`}
  style={variant === 'primary' ? 'background-color: #a3738b;' : ''}
  onmouseover={variant === 'primary' ? "this.style.backgroundColor='white'; this.style.color='#a3738b'" : (variant === 'secondary' ? "this.style.backgroundColor='#a3738b'; this.style.color='white'" : '')}
  onmouseout={variant === 'primary' ? "this.style.backgroundColor='#a3738b'; this.style.color='white'" : (variant === 'secondary' ? "this.style.backgroundColor='white'; this.style.color='#a3738b'" : '')}
>
  <slot />
</a>
