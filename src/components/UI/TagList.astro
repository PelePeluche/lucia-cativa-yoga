---
/**
 * Componente para mostrar una lista de etiquetas estilizadas
 */
interface Props {
  tags: string[];
  backgroundColor?: string;
  textColor?: string;
}

const { 
  tags,
  backgroundColor = 'bg-lucia-mauve',
  textColor = 'text-white'
} = Astro.props;
---

<div class="flex flex-wrap gap-3" data-aos="fade-up" data-aos-delay="100">
  {tags.map(tag => (
    <span class={`px-3 py-1 text-sm rounded-full`} style={backgroundColor === 'bg-lucia-mauve' ? 'background-color: #a3738b; color: white;' : `${backgroundColor} ${textColor}`}>
      {tag}
    </span>
  ))}
</div>
