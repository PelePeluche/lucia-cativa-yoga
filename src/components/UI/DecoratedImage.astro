---
/**
 * Componente de imagen con efecto de sombra decorativa
 */
interface Props {
  src: string;
  alt: string;
  backgroundColor?: string;
  offsetX?: string;
  offsetY?: string;
}

const { 
  src, 
  alt, 
  backgroundColor = 'bg-lucia-rose',
  offsetX = 'translate-x-3',
  offsetY = 'translate-y-3'
} = Astro.props;
---

<figure class="relative">
  <div class={`absolute inset-0 transform ${offsetX} ${offsetY} rounded-sm`} style={backgroundColor === 'bg-lucia-rose' ? 'background-color: #e0a6a8;' : backgroundColor}></div>
  <img 
    src={src} 
    alt={alt} 
    class="relative z-10 w-full h-auto rounded-sm shadow-md object-cover"
  />
</figure>
