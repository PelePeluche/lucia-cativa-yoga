---
/**
 * Componente Card reutilizable para mostrar servicios, clases, etc.
 */
interface Props {
  title: string;
  description: string;
  imageSrc: string;
  imageAlt?: string;
  details?: string[];
  ctaText?: string;
  ctaLink?: string;
}

const { 
  title, 
  description, 
  imageSrc,
  imageAlt = title,
  details = [],
  ctaText,
  ctaLink
} = Astro.props;

import Button from './Button.astro';
---

<article class="bg-white rounded-lg shadow-lg overflow-hidden" data-aos="fade-up" data-aos-delay="200">
  <div class="relative h-64">
    <img 
      src={imageSrc} 
      alt={imageAlt} 
      class="w-full h-full object-cover"
    />
    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 p-4">
      <h3 class="text-xl font-bold text-white">
        {title}
      </h3>
    </div>
  </div>
  
  <div class="p-6">
    <p class="text-gray-700 mb-4">
      {description}
    </p>
    
    {details.length > 0 && (
      <ul class="text-gray-600 mb-6 list-disc pl-5 space-y-1">
        {details.map((detail) => (
          <li>{detail}</li>
        ))}
      </ul>
    )}
    
    {ctaText && ctaLink && (
      <Button 
        text={ctaText}
        href={ctaLink}
        variant="primary"
        size="md"
      />
    )}
  </div>
</article>
