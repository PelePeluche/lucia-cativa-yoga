---
// MyClasses component reestructurado con beneficios y nueva paleta
import { EXTERNAL_LINKS } from "../../constants";
import { useI18n } from "../../i18n/useI18n.ts";
import SectionTitle from "../ui/common/SectionTitle.astro";

// Use centralized i18n hook
const { currentLang, t } = useI18n(Astro.request);

// Generate the section ID based on language
const sectionId = currentLang === "en" ? "yoga-online" : "yoga-online";

// Preparar beneficios para la sección online
const benefits = [
  t("myClasses.onlineClasses.benefits.benefit1"),
  t("myClasses.onlineClasses.benefits.benefit2"),
  t("myClasses.onlineClasses.benefits.benefit3"),
  t("myClasses.onlineClasses.benefits.benefit4"),
  t("myClasses.onlineClasses.benefits.benefit5"),
];
---

<!-- Sección principal de Yoga Online -->
<section id={sectionId} class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Título principal con nueva paleta -->
    <SectionTitle
      title={t("myClasses.title")}
      alignment="center"
      titleColor="text-lucia-ink"
      lineColor="bg-lucia-mauve"
    />

    <!-- Subtítulo optimizado para SEO -->
    <div
      class="text-center mb-8 max-w-4xl mx-auto"
      data-aos="fade-up"
      data-aos-delay="100"
    >
      <h2 class="text-2xl md:text-3xl font-heading text-lucia-mauve mb-4">
        {t("myClasses.subtitle")}
      </h2>
      <p class="text-lg text-lucia-ink leading-relaxed">
        {t("myClasses.description")}
      </p>
    </div>

    <!-- Contenido principal de Yoga Online -->
    <div
      class="bg-lucia-cream rounded-lg p-8 md:p-12 mb-12"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Descripción y detalles -->
        <div>
          <h3 class="text-xl md:text-2xl font-heading text-lucia-mauve mb-6">
            {t("myClasses.onlineClasses.title")}
          </h3>

          <p class="text-lucia-ink mb-6 leading-relaxed">
            {t("myClasses.onlineClasses.description")}
          </p>

          <p class="text-lucia-teal mb-6 font-medium">
            {t("myClasses.onlineClasses.introClasses")}
          </p>

          <p class="text-lucia-ink mb-8 leading-relaxed">
            {t("myClasses.onlineClasses.details")}
          </p>

          <!-- CTA principal -->
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={currentLang === "en" ? "/en/online-yoga" : "/yoga-online"}
              class="inline-block px-8 py-4 bg-lucia-mauve text-white font-medium text-center tracking-wide uppercase hover:bg-lucia-rose hover:text-lucia-ink transition duration-300 rounded-sm"
            >
              {t("myClasses.onlineClasses.cta")}
            </a>
          </div>
        </div>

        <!-- Bloque de beneficios -->
        <div>
          <h4 class="text-lg md:text-xl font-heading text-lucia-teal mb-6">
            {t("myClasses.onlineClasses.benefits.title")}
          </h4>

          <ul class="space-y-4">
            {
              benefits.map((benefit) => (
                <li class="flex items-start">
                  <div class="flex-shrink-0 w-2 h-2 bg-lucia-mauve rounded-full mt-2 mr-3" />
                  <span class="text-lucia-ink leading-relaxed">
                    {benefit}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Sección de Yoga Presencial -->
    <div
      id="yoga-presencial"
      class="bg-lucia-rose bg-opacity-30 rounded-lg p-8 md:p-12"
      data-aos="fade-up"
      data-aos-delay="300"
    >
      <div class="text-center mb-8">
        <h3
          class="text-3xl sm:text-4xl font-heading font-bold mb-3 section-title"
        >
          {t("myClasses.inPersonClasses.title")}
        </h3>
        <div class="w-24 h-1 mx-auto mb-4 section-line"></div>
        <p class="text-lg text-lucia-ink leading-relaxed max-w-3xl mx-auto">
          {t("myClasses.inPersonClasses.description")}
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <p class="text-lucia-ink mb-6 leading-relaxed text-center">
          {t("myClasses.inPersonClasses.details")}
        </p>

        <p class="text-lucia-teal mb-8 text-center font-medium">
          {t("myClasses.inPersonClasses.contact")}
        </p>

        <!-- CTAs para presencial -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#contacto"
            class="inline-block px-8 py-4 bg-lucia-teal text-white font-medium text-center tracking-wide uppercase hover:bg-lucia-mauve transition duration-300 rounded-sm"
          >
            {t("myClasses.inPersonClasses.cta")}
          </a>
          <a
            href={EXTERNAL_LINKS.INSTAGRAM}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-4 bg-transparent border-2 border-lucia-teal text-lucia-teal font-medium text-center tracking-wide uppercase hover:bg-lucia-teal hover:text-white transition duration-300 rounded-sm"
          >
            {t("myClasses.inPersonClasses.followIG")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
