---
// Testimonials section component
import { useI18n } from '../../i18n/useI18n.ts';
import SectionTitle from '../ui/common/SectionTitle.astro';
import TestimonialCard from '../ui/cards/TestimonialCard.astro';
import CTAButton from '../ui/buttons/CTAButton.astro';

// Use centralized i18n hook
const { currentLang, t } = useI18n(Astro.request);

// Import real testimonials data
import testimonialsData from '../../i18n/testimonials.json';

// Use real testimonials data - select first 6 for display
const testimonials = testimonialsData.testimonials.slice(0, 6);
---

<section id="testimonios" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Título de sección -->
    <SectionTitle 
      title="Lo que dicen mis alumnas" 
      alignment="center" 
      titleColor="text-lucia-brown" 
      lineColor="bg-lucia-mauve"
    />

    <!-- Grid de testimonios -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" data-aos="fade-up" data-aos-delay="200">
      {testimonials.map((testimonial, index) => (
        <div data-aos="fade-up" data-aos-delay={300 + index * 100}>
          <TestimonialCard 
            name={testimonial.name}
            text={testimonial.text}
          />
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12" data-aos="fade-up" data-aos-delay="600">
      <p class="text-lucia-brown mb-6 text-lg">¿Lista para comenzar tu transformación?</p>
      <CTAButton 
        href="/#sobre-mi"
        variant="secondary"
        size="large"
      >
        Conoce mi historia
      </CTAButton>
    </div>
  </div>
</section>
