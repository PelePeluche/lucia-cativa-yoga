---
// Gallery section component (Fotitos)
import { useI18n } from '../../i18n/useI18n.ts';
import SectionTitle from '../ui/common/SectionTitle.astro';
import { SECTION_SPACING, AOS_PRESETS, RESPONSIVE_CLASSES, HOVER_ANIMATIONS } from '../../constants';

// Use centralized i18n hook
const { currentLang, t } = useI18n(Astro.request);

// Gallery images
const galleryImages = [
  {
    src: "/img/hatha-yoga.jpeg",
    alt: "Práctica de Hatha Yoga"
  },
  {
    src: "/img/vinyasa-flow.jpeg", 
    alt: "Secuencia de Vinyasa Flow"
  },
  {
    src: "/img/yin-yoga.jpeg",
    alt: "Sesión de Yin Yoga"
  },
  {
    src: "/img/hero-yoga.jpeg",
    alt: "Yoga al aire libre"
  }
];
---

<section id="galeria" class="w-full h-screen" style="background-color: #577874;">
  <!-- Grid de imágenes -->
  <div class="grid grid-cols-4 h-full w-full">
    {galleryImages.map((image, index) => (
      <div class={`group relative overflow-hidden ${HOVER_ANIMATIONS.scale}`} {...AOS_PRESETS.zoomIn}>
        <img 
          src={image.src} 
          alt={image.alt}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
        />
        <div class="absolute inset-0 bg-lucia-mauve bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
      </div>
    ))}
  </div>
</section>
