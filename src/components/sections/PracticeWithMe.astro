---
// Practice With Me section component (Practica Conmigo)
import { useI18n } from "../../i18n/useI18n.ts";
import CTAButton from "../ui/buttons/CTAButton.astro";
import DecoratedImage from "../ui/common/DecoratedImage.astro";
import {
  SECTION_SPACING,
  RESPONSIVE_CLASSES,
  EXTERNAL_LINKS,
} from "../../constants";

// Use centralized i18n hook
const { t } = useI18n(Astro.request);
---

<section
  id="practica-conmigo"
  class={`${SECTION_SPACING.padding.mobile} ${SECTION_SPACING.padding.desktop}`}
  style="background-color: #577874;"
>
  <div class="max-w-6xl mx-auto">
    <!-- Main Layout: Content Left + Image Right -->
    <div class="flex flex-col lg:flex-row items-stretch gap-12">
      <!-- Left Column: Text + Buttons -->
      <div class="w-full lg:w-3/5 flex flex-col justify-between">
        <!-- Title and Intro -->
        <div>
          <h2
            class={`font-heading ${RESPONSIVE_CLASSES.text.subheading} text-white mb-10 relative`}
          >
            {t("practiceWithMe.title")}
            <span
              class="absolute -bottom-2 left-0 w-16 h-1 rounded-full"
              style="background-color: #e0a6a8;"
            ></span>
          </h2>
          <div class="space-y-6 text-white leading-relaxed">
            <p class={RESPONSIVE_CLASSES.text.body} set:html={t("practiceWithMe.intro1")} />
            <p class={RESPONSIVE_CLASSES.text.body} set:html={t("practiceWithMe.intro2")} />
            <p class={RESPONSIVE_CLASSES.text.body} set:html={t("practiceWithMe.intro3")} />
          </div>
        </div>
        
        <!-- Choose Text + Buttons aligned with image bottom -->
        <div class="mt-8 lg:mt-0">
          <p class={`font-heading ${RESPONSIVE_CLASSES.text.large} text-white mb-6`}>
            {t("practiceWithMe.chooseText")}
          </p>

          <!-- Two Simple Buttons - Vertical on mobile, horizontal on desktop -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <CTAButton
              href={EXTERNAL_LINKS.YOGA_ONLINE_PAGE}
              variant="primary"
              size="large"
              class="w-full"
            >
              Yoga Online
            </CTAButton>
            
            <CTAButton
              href={EXTERNAL_LINKS.YOGA_PRESENCIAL_PAGE}
              variant="primary"
              size="large"
              class="w-full"
            >
              Yoga Presencial
            </CTAButton>
          </div>
        </div>
      </div>

      <!-- Right Column: Image -->
      <div class="w-full lg:w-2/5">
        <DecoratedImage
          src="/img/PRACTICA CONMIGO.jpg"
          alt="Lucía Cativa - Practicá Conmigo"
        />
      </div>
    </div>
  </div>
</section>
