---
// Practice With Me section component (Practica Conmigo)
import { useI18n } from '../../i18n/useI18n.ts';
import SectionTitle from '../ui/common/SectionTitle.astro';

// Use centralized i18n hook
const { currentLang, t } = useI18n(Astro.request);
---

<section id="practica-conmigo" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Título de sección -->
    <SectionTitle 
      title="Practica Conmigo" 
      alignment="center" 
      titleColor="text-lucia-brown" 
      lineColor="bg-lucia-mauve"
    />

    <!-- Subtítulo -->
    <div class="text-center mb-12 max-w-4xl mx-auto" data-aos="fade-up" data-aos-delay="100">
      <h2 class="text-2xl md:text-3xl font-heading text-lucia-mauve mb-4">
        Clases de Vinyasa Yoga Online – practicá donde y cuando quieras
      </h2>
      <p class="text-lg text-lucia-brown leading-relaxed">
        Una forma de estar cerca, incluso en la distancia. Este espacio está pensado para que puedas 
        practicar yoga dinámico a tu propio ritmo, desde donde estés y cuantas veces quieras.
      </p>
    </div>

    <!-- Contenido principal -->
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Descripción -->
      <div data-aos="fade-right" data-aos-delay="200">
        <h3 class="text-xl md:text-2xl font-heading text-lucia-mauve mb-6">
          Yoga Online
        </h3>
        
        <p class="text-lucia-brown mb-6 leading-relaxed">
          Las clases son de estilo vinyasa, un estilo intenso y fluido, 
          donde las posturas se enlazan en secuencias sincronizadas 
          con la respiración. Son ideales tanto si nunca practicaste 
          yoga, si querés iniciarte en vinyasa yoga online o si buscás 
          profundizar tu práctica desde casa.
        </p>
        
        <p class="text-lucia-teal mb-6 font-medium">
          Incluye un ciclo de clases introductorias para familiarizarte 
          con el estilo de manera progresiva y segura antes de 
          avanzar a las secuencias regulares.
        </p>
        
        <p class="text-lucia-brown mb-8 leading-relaxed">
          El objetivo no es la perfección, sino el equilibrio entre 
          esfuerzo y comodidad, avanzando de forma progresiva.
        </p>
        
        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href="/yoga-online"
            class="inline-block px-8 py-4 bg-lucia-mauve text-white font-medium text-center tracking-wide uppercase hover:bg-lucia-rose hover:text-lucia-brown transition duration-300 rounded-sm"
          >
            Ver clases online
          </a>
          <a 
            href="/yoga-presencial"
            class="inline-block px-8 py-4 bg-transparent border-2 border-lucia-teal text-lucia-teal font-medium text-center tracking-wide uppercase hover:bg-lucia-teal hover:text-white transition duration-300 rounded-sm"
          >
            Clases presenciales
          </a>
        </div>
      </div>
      
      <!-- Beneficios -->
      <div data-aos="fade-left" data-aos-delay="300">
        <h4 class="text-lg md:text-xl font-heading text-lucia-teal mb-6">
          Beneficios de practicar conmigo:
        </h4>
        
        <ul class="space-y-4">
          <li class="flex items-start">
            <div class="flex-shrink-0 w-2 h-2 bg-lucia-mauve rounded-full mt-2 mr-3"></div>
            <span class="text-lucia-brown leading-relaxed">Accedé a las clases cuando y donde quieras.</span>
          </li>
          <li class="flex items-start">
            <div class="flex-shrink-0 w-2 h-2 bg-lucia-mauve rounded-full mt-2 mr-3"></div>
            <span class="text-lucia-brown leading-relaxed">Avanzá a tu ritmo, con progresiones cuidadas.</span>
          </li>
          <li class="flex items-start">
            <div class="flex-shrink-0 w-2 h-2 bg-lucia-mauve rounded-full mt-2 mr-3"></div>
            <span class="text-lucia-brown leading-relaxed">Fortalecé y flexibilizá tu cuerpo sin forzarlo.</span>
          </li>
          <li class="flex items-start">
            <div class="flex-shrink-0 w-2 h-2 bg-lucia-mauve rounded-full mt-2 mr-3"></div>
            <span class="text-lucia-brown leading-relaxed">Conectá con tu respiración y reducí el estrés.</span>
          </li>
          <li class="flex items-start">
            <div class="flex-shrink-0 w-2 h-2 bg-lucia-mauve rounded-full mt-2 mr-3"></div>
            <span class="text-lucia-brown leading-relaxed">Practicá en un entorno seguro, guiada por una instructora con experiencia personal en recuperación física.</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
