---
// Yoga Presencial section component - Alternating sections
import { useI18n } from "../../i18n/useI18n.ts";
import CTAButton from "../ui/buttons/CTAButton.astro";
import DecoratedImage from "../ui/common/DecoratedImage.astro";
import StarOrnament from "../ui/common/StarOrnament.astro";
import {
  SECTION_SPACING,
  RESPONSIVE_CLASSES,
  EXTERNAL_LINKS,
} from "../../constants";

// Import structured schedule/levels/prices data (bilingual: es / en)
import presencialInfoData from "../../i18n/presencial-info.json";

// Use centralized i18n hook
const { t, currentLang } = useI18n(Astro.request);

// Pick info for the current language, falling back to Spanish
const info = presencialInfoData[currentLang] ?? presencialInfoData.es;
---

<!-- Section 1: Hero with Image + Intro -->
<section class={`${SECTION_SPACING.padding.mobile} ${SECTION_SPACING.padding.desktop} bg-lucia-cream`}>
  <div class="max-w-6xl mx-auto">
    <article class="flex flex-col lg:flex-row items-start gap-12">
      <div class="w-full lg:w-2/5 flex items-start justify-center">
        <div class="max-w-xs">
          <DecoratedImage
            src="/img/YOGA EN CORDOBA.jpg"
            alt="Yoga Presencial"
          />
        </div>
      </div>
      <div class="w-full lg:w-3/5">
        <h1 class={`font-heading ${RESPONSIVE_CLASSES.text.subheading} text-lucia-ink mb-6 relative`}>
          {t("yogaPresencial.title")}
          <span class="absolute -bottom-2 left-0 w-16 h-1 rounded-full" style="background-color: #e0a6a8;"></span>
        </h1>
        <div class="space-y-4 text-lucia-ink leading-relaxed mb-8">
          <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaPresencial.intro1")} />
          <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaPresencial.intro2")} />
          <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaPresencial.intro3")} />
          <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaPresencial.intro4")} />
        </div>
        
        <!-- CTA Button -->
        <CTAButton
          href={EXTERNAL_LINKS.CONTACT_FORM}
          variant="primary"
          size="large"
          target="_blank"
          class="w-full sm:w-auto"
        >
          {t("yogaPresencial.cta")}
        </CTAButton>
      </div>
    </article>
  </div>
</section>

<!-- Section 2: Horarios, Niveles y Valores (flyer-style panels) -->
<section class={`${SECTION_SPACING.padding.mobile} ${SECTION_SPACING.padding.desktop} bg-lucia-cream`}>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

      <!-- Horarios -->
      <div class="flyer-holder">
        <article class="flyer-panel">
          <StarOrnament />
          <h2 class="flyer-title">{info.schedule.title}</h2>
          <p class="flyer-subtitle">{info.schedule.handle}</p>
          <div class="flyer-body">
            <table class="flyer-table">
              <thead>
                <tr>
                  {info.schedule.headers.map((header, index) => (
                    <th class={index === 0 ? "flyer-col-time" : ""}>{header}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {info.schedule.rows.map((row) => (
                  <tr>
                    <td>{row.time}</td>
                    {row.cells.map((cell) => (
                      <td class={cell?.accent ? "flyer-accent" : ""}>{cell?.name ?? ""}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="flyer-note-italic">{info.schedule.address}</p>
          <p class="flyer-note-bold">{info.schedule.note}</p>
        </article>
      </div>

      <!-- Niveles -->
      <div class="flyer-holder">
        <article class="flyer-panel">
          <StarOrnament />
          <h2 class="flyer-title">{info.levels.title}</h2>
          <div class="flyer-body flyer-levels">
            {info.levels.items.map((level) => (
              <div>
                <h3 class={`flyer-level-name ${level.accent ? "flyer-accent" : ""}`}>
                  {level.name}
                </h3>
                <p class="flyer-text">{level.description}</p>
                <p class="flyer-text flyer-italic">{level.ideal}</p>
              </div>
            ))}
          </div>
        </article>
      </div>

      <!-- Valores -->
      <div class="flyer-holder">
        <article class="flyer-panel">
          <StarOrnament />
          <h2 class="flyer-title">{info.prices.title}</h2>
          <p class="flyer-subtitle">{info.prices.subtitle}</p>
          <div class="flyer-body">
            <ul class="flyer-prices">
              {info.prices.items.map((item) => (
                <li>
                  {item.label} <strong>{item.price}</strong>
                  {item.period && <span> {item.period}</span>}
                </li>
              ))}
            </ul>
            <p class="flyer-important">{info.prices.importantTitle}</p>
            <ul class="flyer-bullets">
              {info.prices.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </div>
          <p class="flyer-note-bold">{info.prices.footer}</p>
        </article>
      </div>

    </div>
  </div>
</section>
