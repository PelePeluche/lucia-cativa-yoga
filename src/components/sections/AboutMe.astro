---
// About Me component con historia personal de Lucía y nueva paleta
import { useI18n } from '../../i18n/useI18n.ts';
import SectionTitle from '../ui/common/SectionTitle.astro';
import DecoratedImage from '../ui/common/DecoratedImage.astro';
import TagList from '../ui/common/TagList.astro';

// Use centralized i18n hook
const { currentLang, t } = useI18n(Astro.request);

// Preparar datos para el componente TagList con nuevas especialidades
const tags = [
  t('aboutMe.tag1'),
  t('aboutMe.tag2'),
  t('aboutMe.tag3'),
  t('aboutMe.tag4')
];
---

<section id={currentLang === 'es' ? 'sobre-mi' : 'about-me'} class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 bg-lucia-cream">
  <div class="max-w-6xl mx-auto">
    <!-- Título de sección usando componente reutilizable -->
    <SectionTitle title={t('aboutMe.title')} alignment="center" titleColor="text-lucia-brown" lineColor="bg-lucia-mauve" />
    
    <article class="flex flex-col lg:flex-row items-start gap-12 mt-12">
      <!-- Profile image with animation from left -->
      <div class="w-full lg:w-2/5 mb-8 lg:mb-0" data-aos="fade-right" data-aos-delay="200" data-aos-offset="300">
        <DecoratedImage 
          src="/img/testimonial-1.png" 
          alt="Lucía Cativa - Instructora de Vinyasa Yoga" 
        />
      </div>
      
      <!-- Historia personal con nueva estructura -->
      <div class="w-full lg:w-3/5" data-aos="fade-left" data-aos-delay="400" data-aos-offset="400">
        <!-- Historia personal en párrafos estructurados -->
        <div class="space-y-4 text-lucia-brown leading-relaxed">
          <p class="text-base md:text-lg">
            {t('aboutMe.subtitle')}
          </p>
          <p class="text-base md:text-lg">
            {t('aboutMe.paragraph1')}
          </p>
          <p class="text-base md:text-lg">
            {t('aboutMe.paragraph2')}
          </p>
          <p class="text-base md:text-lg font-medium">
            {t('aboutMe.paragraph3')}
          </p>
        </div>
        
        <!-- Especialidades usando TagList con nueva paleta -->
        <div class="mt-8">
          <TagList 
            tags={tags} 
          />
        </div>
      </div>
    </article>
  </div>
</section>
