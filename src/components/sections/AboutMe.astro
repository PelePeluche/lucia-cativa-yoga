---
// About Me section component
import DecoratedImage from "../ui/common/DecoratedImage.astro";
import CTAButton from "../ui/buttons/CTAButton.astro";
import { useI18n } from "../../i18n/useI18n.ts";
import {
  SECTION_SPACING,
  RESPONSIVE_CLASSES,
  EXTERNAL_LINKS,
} from "../../constants";

// Use centralized i18n hook
const { currentLang, t } = useI18n(Astro.request);
---

<section
  id={currentLang === "es" ? "sobre-mi" : "about-me"}
  class={`${SECTION_SPACING.padding.mobile} ${SECTION_SPACING.padding.desktop}`}
  style="background-color: #f9f0dc;"
>
  <div class="max-w-6xl mx-auto">
    <article class="flex flex-col lg:flex-row items-start gap-12">
      <!-- Profile image -->
      <div class="w-full lg:w-2/5 mb-8 lg:mb-0">
        <DecoratedImage
          src="/img/YOGA SOBRE MI.jpg"
          alt="Lucía Cativa - Instructora de Vinyasa Yoga"
        />
      </div>

      <!-- Text content -->
      <div class="w-full lg:w-3/5">
        <h2
          class={`font-heading ${RESPONSIVE_CLASSES.text.subheading} text-lucia-ink mb-6 relative`}
        >
          {t("aboutMe.title")}
          <span
            class="absolute -bottom-2 left-0 w-16 h-1 rounded-full"
            style="background-color: #e0a6a8;"></span>
        </h2>

        <div class="space-y-4 text-lucia-ink leading-relaxed">
          <p class={RESPONSIVE_CLASSES.text.body} set:html={t("aboutMe.subtitle")} />
          <p class={RESPONSIVE_CLASSES.text.body} set:html={t("aboutMe.paragraph1")} />
          <p class={RESPONSIVE_CLASSES.text.body} set:html={t("aboutMe.paragraph2")} />
          <p class={RESPONSIVE_CLASSES.text.body} set:html={t("aboutMe.paragraph3")} />
        </div>

        <!-- CTA Button -->
        <div class="mt-8">
          <CTAButton
            href={EXTERNAL_LINKS.PRACTICE_SECTION}
            variant="primary"
            size="medium"
            class="w-full sm:w-auto"
          >
            {t("aboutMe.cta")}
          </CTAButton>
        </div>
      </div>
    </article>
  </div>
</section>
