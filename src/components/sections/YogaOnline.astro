---
// Yoga Online section component - Alternating sections
import { useI18n } from "../../i18n/useI18n.ts";
import CTAButton from "../ui/buttons/CTAButton.astro";
import DecoratedImage from "../ui/common/DecoratedImage.astro";
import {
  SECTION_SPACING,
  RESPONSIVE_CLASSES,
  EXTERNAL_LINKS,
} from "../../constants";

// Use centralized i18n hook
const { t } = useI18n(Astro.request);
---

<!-- Section 1: Hero with Image + Intro -->
<section class={`${SECTION_SPACING.padding.mobile} ${SECTION_SPACING.padding.desktop} bg-lucia-cream`}>
  <div class="max-w-6xl mx-auto">
    <article class="flex flex-col lg:flex-row items-stretch gap-12">
      <div class="w-full lg:w-2/5">
        <DecoratedImage
          src="/img/YOGA ONLINE.jpg"
          alt="Yoga Online"
        />
      </div>
      <div class="w-full lg:w-3/5 flex flex-col">
        <!-- Título arriba -->
        <h1 class={`font-heading ${RESPONSIVE_CLASSES.text.subheading} text-lucia-ink mb-6 relative`}>
          {t("yogaOnline.title")}
          <span class="absolute -bottom-2 left-0 w-16 h-1 rounded-full" style="background-color: #e0a6a8;"></span>
        </h1>

        <!-- Cuerpo empujado al fondo (alineado con el borde inferior de la imagen) -->
        <div class="mt-auto flex flex-col gap-6">
          <!-- Párrafos intro -->
          <div class="space-y-2 text-lucia-ink leading-relaxed">
            <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaOnline.intro1")} />
            <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaOnline.intro2")} />
            <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaOnline.intro3")} />
            <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaOnline.intro3b")} />
          </div>

          <!-- Cómo funciona -->
          <div class="text-lucia-ink">
            <p class={`font-body font-bold ${RESPONSIVE_CLASSES.text.body} mb-2`}>{t("yogaOnline.intro4")}</p>
            <ol class="space-y-1 pl-4 leading-relaxed">
              <li class={RESPONSIVE_CLASSES.text.body}>1. {t("yogaOnline.step1")}</li>
              <li class={RESPONSIVE_CLASSES.text.body}>2. {t("yogaOnline.step2")}</li>
              <li class={RESPONSIVE_CLASSES.text.body}>3. {t("yogaOnline.step3")}</li>
            </ol>
            <p class={`font-body ${RESPONSIVE_CLASSES.text.body} mt-4`} set:html={t("yogaOnline.valor")} />
          </div>

          <!-- Guía de acompañamiento -->
          <div class="text-lucia-ink leading-relaxed">
            <p class={`font-body font-bold ${RESPONSIVE_CLASSES.text.body} mb-2`}>{t("yogaOnline.intro5Title")}</p>
            <p class={RESPONSIVE_CLASSES.text.body} set:html={t("yogaOnline.intro5")} />
          </div>
        </div>
      </div>
    </article>
  </div>
</section>


<!-- Section 3: Beneficios + CTA -->
<section class={`${SECTION_SPACING.padding.mobile} ${SECTION_SPACING.padding.desktop}`} style="background-color: #577874;">
  <div class="max-w-6xl mx-auto">
    <article class="flex flex-col lg:flex-row items-start gap-12">
      <!-- Texto izquierda -->
      <div class="w-full lg:w-1/2 lg:pt-12">
        <h2 class={`font-heading ${RESPONSIVE_CLASSES.text.large} text-white mb-8 relative pb-2`}>
          {t("yogaOnline.benefitsTitle")}
          <span class="absolute bottom-0 left-0 w-16 h-1 rounded-full bg-lucia-rose"></span>
        </h2>
        <div class="space-y-4 mb-12">
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="#a3738b" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class={`${RESPONSIVE_CLASSES.text.body} text-white`} set:html={t("yogaOnline.benefit1")} />
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="#a3738b" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class={`${RESPONSIVE_CLASSES.text.body} text-white`} set:html={t("yogaOnline.benefit2")} />
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="#a3738b" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class={`${RESPONSIVE_CLASSES.text.body} text-white`} set:html={t("yogaOnline.benefit3")} />
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 flex-shrink-0 mt-1" fill="none" stroke="#a3738b" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class={`${RESPONSIVE_CLASSES.text.body} text-white`} set:html={t("yogaOnline.benefit4")} />
          </div>
        </div>
        
        <!-- CTA -->
        <CTAButton
          href={EXTERNAL_LINKS.YOGA_ONLINE_WHATSAPP}
          variant="primary"
          size="large"
          target="_blank"
          class="w-full sm:w-auto"
        >
          {t("yogaOnline.cta")}
        </CTAButton>
      </div>

      <!-- Imagen derecha -->
      <div class="w-full lg:w-1/2 flex items-start justify-center">
        <div class="max-w-sm">
          <DecoratedImage
            src="/img/YOGA ONLINE 2.jpg"
            alt="Beneficios Yoga Online"
          />
        </div>
      </div>
    </article>
  </div>
</section>
