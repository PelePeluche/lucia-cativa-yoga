---
// Footer component with internationalization support
import { getLanguageFromURL, useTranslations, DEFAULT_LANGUAGE } from '../i18n/utils';

// Get the current language from the URL or use default
const pathname = new URL(Astro.request.url).pathname;
const currentLang = getLanguageFromURL(pathname) || DEFAULT_LANGUAGE;
const t = useTranslations(currentLang);

const currentYear = new Date().getFullYear();
---

<footer class="pt-12 pb-8 px-4" style="background-color: #9a8576; color: #f9f0dc;">
  <div class="max-w-7xl mx-auto">
    <!-- Top section with logo, navigation and social media -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-10 border-b" style="border-color: rgba(249, 240, 220, 0.3);">
      
      <!-- Logo and address info -->
      <div data-aos="fade-up" data-aos-delay="100">
        <h3 class="text-xl font-heading mb-4" style="color: #a3738b;">LU CATIVA</h3>
        <p class="mb-2" style="color: rgba(249, 240, 220, 0.8);">{t('footer.address')}</p>
        <p class="mb-2" style="color: rgba(249, 240, 220, 0.8);">{t('footer.emailLabel')}: hola@luciacativa.com</p>
        <p style="color: rgba(249, 240, 220, 0.8);">{t('footer.phone')}</p>
      </div>
      
      <!-- Quick links -->
      <div data-aos="fade-up" data-aos-delay="200">
        <h3 class="text-md font-medium mb-4 uppercase tracking-wider">{t('footer.followMe')}</h3>
        <div class="flex space-x-4 mb-6">
          <!-- Social media icons -->
          <a href="https://instagram.com/luciacativa" class="transition duration-300" style="color: rgba(249, 240, 220, 0.8);" onmouseover="this.style.color='#a3738b';" onmouseout="this.style.color='rgba(249, 240, 220, 0.8)';">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="https://youtube.com/@luciacativa" class="transition duration-300" style="color: rgba(249, 240, 220, 0.8);" onmouseover="this.style.color='#a3738b';" onmouseout="this.style.color='rgba(249, 240, 220, 0.8)';">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
          </a>
          <a href="https://facebook.com/luciacativa" class="transition duration-300" style="color: rgba(249, 240, 220, 0.8);" onmouseover="this.style.color='#a3738b';" onmouseout="this.style.color='rgba(249, 240, 220, 0.8)';">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
            </svg>
          </a>
        </div>
        
        <!-- Legal links -->
        <div class="grid grid-cols-1 gap-2">
          <a href="#" class="transition duration-200 text-sm" style="color: rgba(249, 240, 220, 0.8);" onmouseover="this.style.color='#f9f0dc';" onmouseout="this.style.color='rgba(249, 240, 220, 0.8)';">
            {t('footer.privacyPolicy')}
          </a>
          <a href="#" class="transition duration-200 text-sm" style="color: rgba(249, 240, 220, 0.8);" onmouseover="this.style.color='#f9f0dc';" onmouseout="this.style.color='rgba(249, 240, 220, 0.8)';">
            {t('footer.termsOfService')}
          </a>
          <a href="#" class="transition duration-200 text-sm" style="color: rgba(249, 240, 220, 0.8);" onmouseover="this.style.color='#f9f0dc';" onmouseout="this.style.color='rgba(249, 240, 220, 0.8)';">
            {t('footer.cookiePolicy')}
          </a>
        </div>
      </div>
      
      <!-- Newsletter subscription -->
      <div data-aos="fade-up" data-aos-delay="300">
        <h3 class="text-md font-medium mb-4 uppercase tracking-wider">{t('footer.newsletter')}</h3>
        <form class="flex flex-col space-y-4" id="newsletter-form">
          <input 
            type="email" 
            placeholder={t('footer.emailPlaceholder')}
            class="px-4 py-2 rounded-sm focus:outline-none text-sm"
            style="background-color: rgba(87, 120, 116, 0.2); border: 1px solid rgba(249, 240, 220, 0.3); color: #f9f0dc;"
            onfocus="this.style.borderColor='#a3738b';"
            onblur="this.style.borderColor='rgba(249, 240, 220, 0.3)';"
            required
          />
          <button type="submit" class="text-white px-4 py-2 rounded-sm text-sm transition duration-300" style="background-color: #a3738b;" onmouseover="this.style.backgroundColor='#577874';" onmouseout="this.style.backgroundColor='#a3738b';">
            {t('footer.subscribeButton')}
          </button>
        </form>
      </div>
    </div>
    
    <!-- Bottom copyright section -->
    <div class="pt-6 text-center">
      <p class="text-sm" style="color: rgba(249, 240, 220, 0.6);">
        &copy; {currentYear} {t('footer.copyright')}
      </p>
    </div>
  </div>
</footer>
