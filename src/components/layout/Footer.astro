---
// Footer component with social links, contact information and legal information
import { useI18n } from "../../i18n/useI18n.ts";
import SocialIcon from "../ui/common/SocialIcon.astro";
import { RESPONSIVE_CLASSES } from "../../constants";
import { SOCIAL_LINKS, SITE_CONFIG } from "../../constants/site.ts";

// Use centralized i18n hook
const { t } = useI18n(Astro.request);
const currentYear = new Date().getFullYear();
---

<footer class="py-8 px-4 bg-lucia-cream">
  <div class="max-w-6xl mx-auto">
    <!-- Compact footer layout -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-6 border-b border-lucia-mauve border-opacity-30"
    >
      <!-- Left side: Logo and contact info -->
      <div>
        <div class="mb-3">
          <img src="/img/IDENTIDAD YOGA (500 x 150 px).svg" alt="Lucía Cativa Yoga" class="h-16 w-auto">
        </div>
        <div class="space-y-1 text-sm">
          <p class="text-lucia-brown opacity-80">{SITE_CONFIG.address}</p>
          <p class="text-lucia-brown opacity-80">{SITE_CONFIG.email}</p>
          <p class="text-lucia-brown opacity-80">{SITE_CONFIG.phone}</p>
        </div>
      </div>

      <!-- Right side: Social media and legal links -->
      <div class="md:text-right">
        <h4
          class={`${RESPONSIVE_CLASSES.text.body} font-medium mb-3 uppercase tracking-wider text-lucia-teal`}
        >
          {t("footer.followMe")}
        </h4>
        <div class="flex space-x-3 mb-4 md:justify-end">
          <SocialIcon platform="instagram" url={SOCIAL_LINKS.instagram} />
          {
            SOCIAL_LINKS.facebook && (
              <SocialIcon platform="facebook" url={SOCIAL_LINKS.facebook} />
            )
          }
          {
            SOCIAL_LINKS.tiktok && (
              <SocialIcon platform="tiktok" url={SOCIAL_LINKS.tiktok} />
            )
          }
        </div>

        <!-- Legal links -->
        <div class="flex flex-wrap gap-3 text-xs md:justify-end">
          <a
            href="#"
            class="text-lucia-brown opacity-60 hover:opacity-100 hover:text-lucia-mauve transition-all duration-200"
          >
            {t("footer.privacyPolicy")}
          </a>
          <a
            href="#"
            class="text-lucia-brown opacity-60 hover:opacity-100 hover:text-lucia-mauve transition-all duration-200"
          >
            {t("footer.termsOfService")}
          </a>
          <a
            href="#"
            class="text-lucia-brown opacity-60 hover:opacity-100 hover:text-lucia-mauve transition-all duration-200"
          >
            {t("footer.cookiePolicy")}
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom copyright section -->
    <div class="pt-4 text-center">
      <p class="text-xs text-lucia-brown opacity-50">
        &copy; {currentYear}
        {t("footer.copyright")}
      </p>
    </div>
  </div>
</footer>
