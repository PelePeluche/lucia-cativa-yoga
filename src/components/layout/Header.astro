---
// Navigation component inspired by Vicky Lobo's reference
// With fixed position to keep it visible when scrolling
import { useI18n } from '../../i18n/useI18n.ts';
import { LANGUAGES, localizedUrl } from '../../i18n/utils.ts';

// Use centralized i18n hook
const { currentLang, t, pathname } = useI18n(Astro.request);

const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<script src="/src/scripts/header.ts"></script>

<style>
  @media (max-width: 767px) {
    .desktop-nav {
      display: none !important;
    }
    .mobile-nav {
      display: block !important;
    }
  }
  @media (min-width: 768px) {
    .mobile-nav {
      display: none !important;
    }
    .desktop-nav {
      display: block !important;
    }
  }
  .nav-link {
    @apply text-xs sm:text-sm font-medium transition-colors duration-200;
    color: #9a8576;
  }
  .nav-link:hover {
    color: #a3738b;
  }
  .nav-link.active {
    color: #a3738b;
    border-bottom: 2px solid #a3738b;
    padding-bottom: 2px;
  }
  .contact-button {
    @apply text-white text-xs font-bold uppercase px-3 py-1 sm:px-4 sm:py-2 transition-colors duration-200 rounded-sm;
    background-color: #a3738b;
  }
  .contact-button:hover {
    background-color: #577874;
  }
  .nav-fixed {
    @apply fixed top-0 left-0 right-0 z-50 transition-all duration-300;
  }
</style>

<!-- Mobile Navigation -->
<nav class="mobile-nav" style="display: none;">
  <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #f9f0dc;">
    <a href="/" style="display: flex; align-items: center;">
      <img src="/img/IDENTIDAD YOGA (500 x 150 px).svg" alt="Lucía Cativa Yoga" style="height: 29px; width: auto;">
    </a>
    <button id="mobile-menu-toggle" type="button" style="background: none; border: none; color: #9a8576; cursor: pointer; padding: 4px;">
      <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
  <!-- Mobile Menu Overlay -->
  <div id="mobile-overlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 40; visibility: hidden; opacity: 0; transition: all 0.3s ease;"></div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" style="position: fixed; top: 0; right: 0; height: 100%; width: 300px; max-width: 85vw; background: #f9f0dc; z-index: 50; transform: translateX(100%); transition: transform 0.3s ease; box-shadow: -4px 0 8px rgba(0,0,0,0.1);">
    <div style="padding: 16px; border-bottom: 1px solid #e0a6a8; display: flex; justify-content: space-between; align-items: center;">
      <a href="/" style="display: flex; align-items: center;">
        <img src="/img/IDENTIDAD YOGA (500 x 150 px).svg" alt="Lucía Cativa Yoga" style="height: 26px; width: auto;">
      </a>
      <button id="mobile-menu-close" type="button" style="background: none; border: none; color: #9a8576; cursor: pointer; padding: 4px;">
        <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div style="padding: 24px; display: flex; flex-direction: column; gap: 20px;">
      <a href="/#sobre-mi" class="nav-link" style="font-size: 1rem; font-weight: 500;">{t('nav.aboutMe')}</a>
      <a href="/yoga-online" class:list={["nav-link", { active: isActive('/yoga-online') }]} style="font-size: 1rem; font-weight: 500;">{t('nav.onlineYoga')}</a>
      <a href="/yoga-presencial" class:list={["nav-link", { active: isActive('/yoga-presencial') }]} style="font-size: 1rem; font-weight: 500;">{t('nav.inPersonYoga')}</a>
      <a href="/blog" class:list={["nav-link", { active: isActive('/blog') }]} style="font-size: 1rem; font-weight: 500;">Blog</a>
      
      <!-- Mobile Contact Button -->
      <div style="padding-top: 8px;">
        <a href="mailto:lucativayoga@gmail.com?subject=Consulta" class="contact-button" style="display: inline-block; text-align: center;">{t('nav.contact')}</a>
      </div>
    </div>
  </div>
</nav>

<!-- Desktop Navigation -->
<nav id="main-nav" class="desktop-nav nav-fixed py-2 sm:py-3 w-full bg-lucia-cream">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <!-- Logo on the left -->  
      <div>
        <a href="/" class="flex items-center">
          <img src="/img/IDENTIDAD YOGA (500 x 150 px).svg" alt="Lucía Cativa Yoga" class="h-10 sm:h-11 md:h-12 w-auto">
        </a>
      </div>
      
      <!-- Central navigation menu -->  
      <div class="flex items-center space-x-3 sm:space-x-5 md:space-x-8">
        <a href="/#sobre-mi" class="nav-link">{t('nav.aboutMe')}</a>
        <a href="/yoga-online" class:list={["nav-link", { active: isActive('/yoga-online') }]}>{t('nav.onlineYoga')}</a>
        <a href="/yoga-presencial" class:list={["nav-link", { active: isActive('/yoga-presencial') }]}>{t('nav.inPersonYoga')}</a>
        <a href="/blog" class:list={["nav-link", { active: isActive('/blog') }]}>Blog</a>
      </div>
      
      <!-- Contact button --> 
      <div class="flex items-center">
        <a href="mailto:lucativayoga@gmail.com?subject=Consulta" class="contact-button">{t('nav.contact')}</a>
      </div>
    </div>
  </div>
</nav>
